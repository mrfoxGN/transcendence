{
  "name": "devup-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:migration": "node scripts/verify-migration.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/shared/design-system/**/*.css\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"README.md\" \"src/app.css\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/shared/design-system/**/*.css\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"README.md\" \"src/app.css\"",
    "check": "npm run typecheck && npm run format:check && npm run check:styles",
    "check:styles": "node scripts/check-style-entry.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/inter": "5.2.6",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "canvas-confetti": "^1.9.4",
    "cmdk": "1.1.1",
    "framer-motion": "^14.10.1",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "prettier": "3.10.1",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
