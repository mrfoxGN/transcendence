
worker_processes auto;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    proxy_hide_header X-Powered-By;
    access_log /dev/stdout;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # Common proxy settings + WebSocket
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' '';
    }

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Login rate limiting
    map $uri $login_limit_key {
        default "";
        ~*^/(?:api/)?auth/login/?$ $binary_remote_addr;
    }
    limit_req_zone $login_limit_key zone=auth_login:10m rate=5r/m;

    client_max_body_size 11m;

    # TLS
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # HTTP -> HTTPS
    server {
        listen 80;
        server_name _;
        return 308 https://localhost:${HTTPS_PORT}$request_uri;
    }

    # Main application
    server {
        listen 443 ssl;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;

        location ^~ /api/ {
            limit_req zone=auth_login burst=5 nodelay;
            limit_req_status 429;
            proxy_pass http://backend:3000/;
        }

        location ~ ^/(auth|github)/ {
            limit_req zone=auth_login burst=5 nodelay;
            limit_req_status 429;
            proxy_pass http://backend:3000;
        }

        location = /health {
            proxy_pass http://backend:3000/health;
        }

        location ^~ /socket.io/ {
            proxy_pass http://backend:3000;
            proxy_read_timeout 75s;
            proxy_buffering off;
        }

        location = /grafana {
            return 308 /grafana/;
        }

        location ^~ /grafana/ {
            set $grafana grafana:3000;
            proxy_pass http://$grafana$request_uri;
        }

        location ~ ^/status/?$ {
            return 302 https://localhost:${GATUS_PORT}/;
        }

        location ^~ /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy no-referrer always;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }

    # Gatus HTTPS
    server {
        listen 8443 ssl;
        server_name _;

        location / {
            set $gatus status-page:8080;
            proxy_pass http://$gatus$request_uri;
        }
    }
}
