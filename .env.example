# Copy to .env only when .env does not already exist.
# Safe defaults for development; production Compose overrides NODE_ENV,
# APP_PORT, DB_HOST and DB_PORT inside its containers.
NODE_ENV=development
APP_PORT=3000

# Same release image for production Backend and migrations.
# Preserve prod for existing setups; choose a unique release tag for deployments.
BACKEND_IMAGE=transcendence-backend:prod

DB_HOST=mysql
DB_PORT=3306
DB_NAME=transcendence
DB_USER=transcendence

# Required secrets: generate independent values locally (openssl rand -hex 32).
# DB_PASSWORD and DB_ROOT_PASSWORD must differ. Changing .env does not rotate
# existing MySQL accounts: coordinate ALTER USER and container recreation.
# Never commit .env.
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# Production monitoring. Generate a separate random value for each secret.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
# 64 hexadecimal characters; then run python3 scripts/setup-mysql-monitoring.py.
MYSQL_EXPORTER_PASSWORD=

# Optional until the GitHub integration is used.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# Required for storing GitHub repository tokens: 32 random bytes in base64.
GITHUB_TOKEN_ENCRYPTION_KEY=
