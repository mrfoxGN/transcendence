# Copy this file to .env and replace secret values locally.
# Never commit .env or reuse local passwords in production.

# ============================================================
# Application
# ============================================================
NODE_ENV=development
APP_PORT=3000
FRONTEND_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
GATUS_PORT=8443
BIND_IP=127.0.0.1
PUBLIC_HOST=localhost
# Local Compose defaults to https://localhost on HTTPS_PORT.
# PUBLIC_ORIGIN=https://devup.example.com

# Same release image for the production Backend and migrations.
BACKEND_IMAGE=transcendence-backend:prod

# ============================================================
# MySQL
# ============================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=transcendence
DB_USER=transcendence
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ============================================================
# Authentication and integrations
# ============================================================
JWT_SECRET=
AUTH_PUBLIC_URL=http://localhost:5173
AUTH_EMAIL_FROM=
RESEND_API_KEY=

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Required for storing GitHub repository tokens: 32 random bytes in base64.
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/github/callback
GITHUB_OAUTH_FRONTEND_URL=http://localhost:5173

# ============================================================
# Production monitoring and backups
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
# 64 hexadecimal characters; then run the MySQL monitoring setup script.
MYSQL_EXPORTER_PASSWORD=
BACKUP_TZ=Africa/Casablanca
