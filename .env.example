# ============================================================
# Application
# ============================================================

NODE_ENV=development
FRONTEND_PORT=8080
HTTPS_PORT=443
# PUBLIC_ORIGIN defaults to https://localhost on HTTPS_PORT.
# Set it to the certificate's HTTPS origin when using a custom hostname.
# PUBLIC_ORIGIN=https://devup.example.com
JWT_SECRET=devup-local-compose-only-change-before-deploying


# ============================================================
# MySQL
# ============================================================

DB_HOST=mysql
DB_PORT=3306
DB_NAME=transcendence
DB_USER=transcendence

# Local development credentials.
# Copy this file to .env and replace these values locally.
# Never reuse local passwords in staging or production.
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Account verification and password reset email
AUTH_EMAIL_FROM=
RESEND_API_KEY=
